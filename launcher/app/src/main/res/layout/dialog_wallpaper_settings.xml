<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FA0B0E14"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="28dp">

    <!-- Left: Scrollable Wallpaper Options List -->
    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.01"
            android:text="@string/wallpaper_label"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Select mode, interval, and shuffling sequence"
            android:textColor="#FF8E9AA8"
            android:textSize="13sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/wpSettingsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#1FFFFFFF" />

    <!-- Right: Apple tvOS Live Preview Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="16dp">

        <!-- Live 16:9 Wallpaper Card Preview -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/settings_choice_bg">

            <ImageView
                android:id="@+id/dialogWpPreviewImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/dialogWpPreviewScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1A000000" />
        </FrameLayout>

        <TextView
            android:id="@+id/dialogWpPreviewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@string/font_medium"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp" />

        <LinearLayout
            android:id="@+id/dialogWpPreviewBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/dialogWpPreviewDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dialogWpApplyPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/pill_bg"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="Press OK to toggle • BACK to close"
            android:textColor="#FFE5F5EC"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
